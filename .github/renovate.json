{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>CosmicDriftGameStudio/infra//renovate/publisher.json"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CI service image pins (tag + index digest) of the kumiko-services action; the mirror workflow copies them to GHCR after merge",
      "managerFilePatterns": [
        "/^\\.github/actions/kumiko-services/service-images\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9.-]+(?:/[a-z0-9._-]+)+):(?<currentValue>[A-Za-z0-9._-]+)\\s+(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Infra tag a newly scaffolded app is pinned to",
      "managerFilePatterns": ["/^packages/dev-server/src/managed-files/registry\\.ts$/"],
      "matchStrings": ["CURRENT_INFRA_REF = \"reusables-v(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "CosmicDriftGameStudio/infra",
      "packageNameTemplate": "CosmicDriftGameStudio/infra",
      "extractVersionTemplate": "^reusables-v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "groupName": "ci-service-images",
      "matchFileNames": [
        ".github/actions/kumiko-services/service-images.txt"
      ],
      "automerge": false
    }
  ]
}
