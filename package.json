{
  "name": "kumiko-framework",
  "version": "0.0.0",
  "description": "Config-driven, command-based, realtime multi-tenant app framework.",
  "private": true,
  "engines": {
    "bun": ">=1.4.4"
  },
  "license": "MIT",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "keywords": [
    "framework",
    "multi-tenant",
    "realtime",
    "command-based",
    "config-driven",
    "typescript",
    "bun",
    "hono",
    "postgres"
  ],
  "workspaces": [
    "packages/framework",
    "packages/types",
    "packages/bundled-features",
    "packages/cli",
    "packages/guards",
    "packages/testing",
    "packages/create-kumiko-app",
    "packages/dev-server",
    "packages/server-runtime",
    "packages/renderer",
    "packages/locale-es",
    "packages/locale-de",
    "packages/locale-fr",
    "packages/locale-it",
    "packages/document-designer",
    "packages/feature-ast",
    "packages/renderer-mail-html",
    "packages/renderer-puppeteer-client",
    "apps/puppeteer-service",
    "packages/samples",
    "samples/recipes/*",
    "samples/apps/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "msgpackr-extract",
    "puppeteer"
  ],
  "bin": {
    "kumiko": "./bin/kumiko.ts"
  },
  "scripts": {
    "kumiko": "bun run bin/kumiko.ts",
    "test": "bun integration.guard.ts && bun test --dots",
    "test:dom": "bun test --dots --config=bunfig.dom.toml --timeout=5000 .test.tsx",
    "test:run": "bun test --dots",
    "test:verbose": "bun test",
    "test:integration": "bun scripts/run-integration-tests.ts",
    "test:integration:perf:strict": "KUMIKO_PERF_GATE=1 bun test --dots --config=bunfig.integration.toml --timeout=15000 packages/framework/src/event-store/__tests__/get-stream-version-perf.integration.test.ts packages/framework/src/engine/__tests__/pipeline-performance.integration.test.ts packages/framework/src/pipeline/__tests__/perf-rebuild.integration.test.ts",
    "test:integration:perf:eventstore": "KUMIKO_PERF_GATE=1 bun test --dots --config=bunfig.integration.toml --timeout=15000 packages/framework/src/event-store/__tests__/perf.integration.test.ts",
    "test:integration:perf": "KUMIKO_PERF_GATE=1 bun scripts/run-integration-tests.ts --perf",
    "typecheck": "tsc --build",
    "build:apps": "bun run scripts/build-apps.ts",
    "build": "echo 'kumiko-framework: packages publish TypeScript source as-is, except those with publishConfig.exports (compiled dist, built at pack time by scripts/pack-with-publish-config.sh).'",
    "check:dist": "bash scripts/verify-dist-packages.sh && bash scripts/verify-samples-package.sh",
    "gen:agent-docs": "bun run scripts/gen-agent-docs.ts",
    "gen:guards-doc": "bun run scripts/gen-guards-doc.ts",
    "gen:sample-index": "bun run samples/apps/use-all-bundled/scripts/gen-sample-index.ts",
    "gen:feature-screenshots": "bun run samples/scripts/gen-feature-screenshots.ts",
    "sync:readme-screenshots": "bash scripts/sync-readme-screenshots.sh",
    "prepare": "[ \"$HUSKY\" = \"0\" ] || git config core.hooksPath .husky 2>/dev/null || true",
    "demo-kit": "bun scripts/demo-kit/engine/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@changesets/cli": "^3.0.3",
    "@cosmicdrift/kumiko-guards": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "bun-types": "^1.4.4",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "resolutions": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "brace-expansion": "^5.0.12",
    "undici": "^7.30.1",
    "ip-address": "^10.7.3",
    "js-yaml": "^4.3.2",
    "html-to-text": "^10.0.1",
    "nodemailer": "^10.0.13",
    "prosemirror-view": "^1.42.6",
    "source-map-js": "^1.2.2"
  },
  "overrides": {
    "html-to-text": "10.0.1",
    "nodemailer": "10.0.13",
    "brace-expansion": "5.0.12",
    "undici": "7.30.1",
    "ip-address": "10.7.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-view": "1.42.6",
    "source-map-js": "1.2.2",
    "@parcel/watcher": "2.6.0"
  },
  "dependencies": {
    "@cosmicdrift/kumiko-cli": "workspace:*",
    "hono": "^4.13.5",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0"
  }
}
