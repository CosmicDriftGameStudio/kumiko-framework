{
  "name": "@cosmicdrift/kumiko-headless",
  "version": "0.356.0",
  "description": "Headless UI logic for Kumiko — Dispatcher contract, Form-Controller, View-Model, Nav-Resolver. Plattform- und React-frei; jeder Renderer (renderer, renderer-web, renderer-native, …) komponiert darauf.",
  "license": "BUSL-1.1",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/headless"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "type": "module",
  "kumiko": {
    "runtime": "client"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dispatcher": {
      "types": "./src/dispatcher/index.ts",
      "default": "./src/dispatcher/index.ts"
    },
    "./apex": {
      "types": "./src/apex/index.ts",
      "default": "./src/apex/index.ts"
    },
    "./locale-routing": {
      "types": "./src/locale-routing/index.ts",
      "default": "./src/locale-routing/index.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-types": "workspace:*",
    "temporal-polyfill": "^0.3.2",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./dispatcher": {
        "types": "./dist/dispatcher/index.d.ts",
        "default": "./dist/dispatcher/index.js"
      },
      "./apex": {
        "types": "./dist/apex/index.d.ts",
        "default": "./dist/apex/index.js"
      },
      "./locale-routing": {
        "types": "./dist/locale-routing/index.d.ts",
        "default": "./dist/locale-routing/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src/changes.json",
    "README.md",
    "LICENSE"
  ]
}
