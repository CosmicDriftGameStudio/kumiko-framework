{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false,
    "rootDir": "./src",
    "outDir": "./dist/tests-check"
  },
  "include": [
    "./src/**/__tests__/**/*",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ],
  "references": [
    { "path": "." },
    { "path": "../types" },
    { "path": "../testing" }
  ]
}
