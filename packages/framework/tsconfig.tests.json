{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false,
    "rootDir": "./src",
    "outDir": "./dist/tests-check"
  },
  "include": [
    "./src/**/__tests__/**/*",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ],
  "exclude": [
    "./src/__tests__/fixtures/migrate-db-raw",
    "./src/__tests__/fixtures/migrate-open-to-all",
    "./src/__tests__/fixtures/migrate-cross-tenant",
    "./src/__tests__/fixtures/object-form",
    "./src/__tests__/fixtures/testing-move"
  ],
  "references": [
    { "path": "." },
    { "path": "../types" },
    { "path": "../http" },
    { "path": "../testing" }
  ]
}
