language js

`$callee($title, $...)` where {
  $callee <: includes or {
    "test",
    "it",
    "describe"
  },
  $title <: or {
    JsStringLiteralExpression(),
    JsTemplateExpression()
  },
  $callee <: r"(?s)(?:test|it|describe)(?:\.[A-Za-z]+)*(?:\.each\(.*\))?",
  or {
    $title <: r"(?i)(?s).*(?:(?-u:\b)(?:der|das|den|dem|des|ein|eine|einen|einem|kann|wird|werden|nicht|wenn|oder|und|mit|ohne|bei|ist|sind|auf|zu|von|vom|zum|zur|im|vor|aus|als|sich|wie|auch|noch|nur|kein|keine|keinen|gibt|darf|muss|soll|liefert|wirft|setzt|zeigt|gewinnt|leer|leere|leerer|bleibt|macht|fehlt|schreibt|liest|sammelt|nennt|akzeptiert|ueber|uber|fuer|gegen|nach|dann|weil|statt|sowie|jede|jeder|jedes)(?-u:\b)).*",
    $title <: r"(?s).*(?:^|[^A-Za-z0-9_])(?:[a-z][A-Za-z0-9_]*)?[äöüß].*",
    $title <: r"(?s).*(?:(?:[A-Za-z0-9_./-]+#[0-9]+|(?:^|[^A-Za-z0-9_./&-])#[0-9]{2,})(?:[^A-Za-z0-9_]|$)).*"
  },
  register_diagnostic(span=$title, message="Test titles are English and state the behaviour, not an issue or PR number (the number belongs in the commit message).", severity="error")
}
