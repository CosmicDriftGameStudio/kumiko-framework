{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["./biome-rules.json"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "src/**",
      "bin/**",
      "kumiko/**",
      "e2e/**",
      "scripts/**",
      "kumiko.config.ts",
      "playwright.config.ts",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-server",
      "!kumiko/migrations",
      "!test-results",
      "!playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "lineWidth": 80
    }
  },
  "overrides": [
    {
      "includes": ["bin/**", "scripts/**", "**/bin/**", "**/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.integration.ts",
        "**/*.e2e.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/bin/**/*.ts",
        "**/src/**/*.ts",
        "!**/bin/env.ts",
        "!**/bin/server.ts",
        "!**/bin/kumiko.ts",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.integration.ts",
        "!**/*.d.ts",
        "!**/node_modules/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "error"
          }
        }
      }
    }
  ]
}
