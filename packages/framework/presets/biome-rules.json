{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noNestedComponentDefinitions": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDebugger": "error",
        "noConsole": "warn",
        "noTsIgnore": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "useConst": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "temporal-polyfill": {
                "importNames": ["Temporal"],
                "message": "import { Temporal } from \"@cosmicdrift/kumiko-types/temporal\" instead — it prefers the native global, so framework and consumer share one set of Temporal classes."
              },
              "temporal-polyfill/global": {
                "message": "import { Temporal } from \"@cosmicdrift/kumiko-types/temporal\" instead — it prefers the native global, so framework and consumer share one set of Temporal classes."
              }
            }
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "plugins": [
    {
      "path": "./biome-plugins/no-date-api.grit",
      "resolutionKind": "config",
      "includes": [
        "**/src/**/*.ts",
        "**/bin/**/*.ts",
        "**/scripts/**/*.ts",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.integration.ts",
        "!**/*.integration.tsx",
        "!**/*.spec.ts",
        "!**/*.d.ts",
        "!**/packages/framework/src/time/**",
        "!**/packages/framework/src/db/**",
        "!**/packages/framework/src/event-store/**",
        "!**/packages/framework/src/pipeline/**",
        "!**/packages/framework/src/errors/**",
        "!**/packages/framework/src/jobs/**",
        "!**/packages/framework/src/api/**",
        "!**/packages/framework/src/logging/**",
        "!**/packages/framework/src/i18n/**",
        "!**/packages/framework/src/observability/**",
        "!**/packages/framework/src/engine/{types,registry,config-helpers,create-app,define-feature,state-machine,access,field-access,boot-validator,qualified-name}.ts",
        "!**/packages/testing/src/helpers/**",
        "!**/packages/framework/src/search/**",
        "!**/packages/framework/src/files/**",
        "!**/packages/server-runtime/src/run-prod-app-static-files.ts",
        "!**/packages/publish/src/rollback.ts",
        "!**/samples/showcases/beammycar/src/migration/**",
        "!**/*.g.ts",
        "!**/packages/*/scripts/**",
        "!**/samples/**/scripts/**"
      ]
    },
    {
      "path": "./biome-plugins/unsafe-json-parse.grit",
      "resolutionKind": "config",
      "includes": [
        "**/src/**/*.ts",
        "**/bin/**/*.ts",
        "**/scripts/**/*.ts",
        "!**/__tests__/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.integration.ts",
        "!**/*.integration.tsx",
        "!**/*.spec.ts",
        "!**/*.d.ts",
        "!**/safe-json.ts",
        "!**/packages/*/scripts/**",
        "!**/samples/**/scripts/**"
      ]
    },
    {
      "path": "./biome-plugins/error-reasons.grit",
      "resolutionKind": "config",
      "includes": [
