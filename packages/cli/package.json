{
  "name": "@cosmicdrift/kumiko-cli",
  "version": "0.391.0",
  "description": "CLI for Kumiko apps. `bunx @cosmicdrift/kumiko-cli new app <name>` scaffolds a runnable workspace; `add feature <name>` mounts a feature; `check` runs boot validation plus the guard suites with the step list derived from kumiko.json; `agent lint`, `project` and `consumer` operate on an existing app; `handbuch build` renders the HTML handbuch.",
  "license": "MIT",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "type": "module",
  "kumiko": {
    "runtime": "dev"
  },
  "bin": {
    "kumiko": "./bin/cli.ts",
    "kumiko-upgrade": "./bin/kumiko-upgrade.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./commands": {
      "types": "./src/commands/index.ts",
      "default": "./src/commands/index.ts"
    },
    "./repo-manifest": {
      "types": "./src/repo-manifest.ts",
      "default": "./src/repo-manifest.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-dev-server": "workspace:*",
    "@cosmicdrift/kumiko-feature-ast": "workspace:*",
    "@cosmicdrift/kumiko-guards": "workspace:*",
    "@cosmicdrift/kumiko-server-runtime": "workspace:*",
    "@cosmicdrift/kumiko-testing": "workspace:*",
    "marked": "^18.0.3",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "sharp": "^0.35.5",
    "@cosmicdrift/kumiko-bundled-features": "workspace:*",
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-renderer": "workspace:*"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "@cosmicdrift/kumiko-bundled-features": {
      "optional": true
    },
    "@cosmicdrift/kumiko-framework": {
      "optional": true
    },
    "@cosmicdrift/kumiko-renderer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cosmicdrift/kumiko-bundled-features": "workspace:*",
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-renderer": "workspace:*",
    "sharp": "^0.35.5"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "bin",
    "src",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE"
  ]
}
