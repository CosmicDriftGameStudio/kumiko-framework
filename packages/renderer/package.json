{
  "name": "@cosmicdrift/kumiko-renderer",
  "version": "0.393.0",
  "description": "React renderer for Kumiko screens. The root export holds the platform-agnostic logic (primitives contract, hooks, KumikoScreen, navigation and SSE abstractions); ./headless the DOM-free UI logic, ./live the HTTP dispatcher, ./web the browser bindings (HTML primitives, history navigation, EventSource live events, createKumikoApp).",
  "license": "MIT",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "type": "module",
  "kumiko": {
    "runtime": "client"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./headless": {
      "types": "./src/headless/index.ts",
      "default": "./src/headless/index.ts"
    },
    "./flow-diagram": {
      "types": "./src/flow-diagram/index.ts",
      "default": "./src/flow-diagram/index.ts"
    },
    "./headless/apex": {
      "types": "./src/headless/apex/index.ts",
      "default": "./src/headless/apex/index.ts"
    },
    "./headless/dispatcher": {
      "types": "./src/headless/dispatcher/index.ts",
      "default": "./src/headless/dispatcher/index.ts"
    },
    "./headless/locale-routing": {
      "types": "./src/headless/locale-routing/index.ts",
      "default": "./src/headless/locale-routing/index.ts"
    },
    "./live": {
      "types": "./src/live/index.ts",
      "default": "./src/live/index.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    },
    "./web/styles.css": "./src/web/styles.css",
    "./web/theme-plugin": {
      "types": "./src/web/theme-plugin.ts",
      "default": "./src/web/theme-plugin.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-types": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/qrcode": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.14.0",
    "pdfjs-dist": "6.3.289",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.0",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.12.2",
    "tailwind-merge": "^3.6.0",
    "temporal-polyfill": "^0.3.2",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/cli": {
      "optional": false
    },
    "tailwindcss": {
      "optional": false
    }
  },
  "devDependencies": {
    "@cosmicdrift/kumiko-locale-de": "workspace:*",
    "@cosmicdrift/kumiko-testing": "workspace:*",
    "@tailwindcss/cli": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://kumiko.rocks",
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./headless": {
        "types": "./dist/headless/index.d.ts",
        "default": "./dist/headless/index.js"
      },
      "./flow-diagram": {
        "types": "./dist/flow-diagram/index.d.ts",
        "default": "./dist/flow-diagram/index.js"
      },
      "./headless/apex": {
        "types": "./dist/headless/apex/index.d.ts",
        "default": "./dist/headless/apex/index.js"
      },
      "./headless/dispatcher": {
        "types": "./dist/headless/dispatcher/index.d.ts",
        "default": "./dist/headless/dispatcher/index.js"
      },
      "./headless/locale-routing": {
        "types": "./dist/headless/locale-routing/index.d.ts",
        "default": "./dist/headless/locale-routing/index.js"
      },
      "./live": {
        "types": "./dist/live/index.d.ts",
        "default": "./dist/live/index.js"
      },
      "./web": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      },
      "./web/styles.css": "./src/web/styles.css",
      "./web/theme-plugin": {
        "types": "./dist/web/theme-plugin.d.ts",
        "default": "./dist/web/theme-plugin.js"
      }
    }
  },
  "files": [
    "dist",
    "src/changes.json",
    "src/web/styles.css",
    "src/web/fonts",
    "README.md",
    "LICENSE"
  ]
}
