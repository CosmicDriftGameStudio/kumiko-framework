#!/usr/bin/env sh
REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ -z "$REPO_ROOT" ]; then
  echo "[pre-push] FATAL: git rev-parse --show-toplevel failed — refusing push" >&2
  exit 1
fi

# Walk up so a worktree without its own node_modules resolves via the parent
# install, but not past an enclosing repository: a bin above that boundary
# belongs to another project. `[ -x ]` also skips a broken (uninstalled) symlink.
BIN=""
DIR="$REPO_ROOT"
while true; do
  CANDIDATE="$DIR/node_modules/.bin/kumiko-pre-push"
  if [ -x "$CANDIDATE" ]; then
    BIN="$CANDIDATE"
    break
  fi
  if [ "$DIR" = "/" ]; then
    break
  fi
  if [ "$DIR" != "$REPO_ROOT" ] && [ -e "$DIR/.git" ]; then
    break
  fi
  DIR="$(dirname "$DIR")"
done

if [ -z "$BIN" ]; then
  echo "[pre-push] kumiko-pre-push not found in any node_modules/.bin above $REPO_ROOT." >&2
  echo "Run \`bun install\`." >&2
  exit 1
fi

cd "$REPO_ROOT" && exec "$BIN" "$@"
