{
  "name": "@cosmicdrift/kumiko-feature-ast",
  "version": "0.401.0",
  "description": "Feature-file AST for Kumiko: parse, patch and render feature definitions, the pattern library, and the codemods kumiko-upgrade runs.",
  "license": "MIT",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "type": "module",
  "kumiko": {
    "runtime": "runtime",
    "bunOnlyExports": [
      "./codemod"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./codemod": {
      "types": "./src/codemod/index.ts",
      "default": "./src/codemod/index.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-types": "workspace:*",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/feature-ast"
  },
  "homepage": "https://kumiko.rocks",
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./codemod": {
        "types": "./dist/codemod/index.d.ts",
        "default": "./dist/codemod/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src/scripts/codemod",
    "src/changes.json",
    "README.md",
    "LICENSE"
  ]
}
