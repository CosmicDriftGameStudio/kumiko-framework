{
  "name": "@cosmicdrift/kumiko-dev-server",
  "version": "0.405.0",
  "description": "Dev-tooling for Kumiko apps: local dev-server bootstrap (runDevApp), scaffolding. Its compose-stacks/env-schema subpaths are consumed at prod boot too — see @cosmicdrift/kumiko-server-runtime for the prod runner itself.",
  "license": "MIT",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/dev-server"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "type": "module",
  "kumiko": {
    "runtime": "dev",
    "bunOnlyExports": [
      ".",
      "./managed-files",
      "./setup-test-stack-from-features",
      "./testing"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./build": {
      "types": "./src/build.ts",
      "default": "./src/build.ts"
    },
    "./compose-stacks": {
      "types": "./src/compose-stacks.ts",
      "default": "./src/compose-stacks.ts"
    },
    "./env-schema": {
      "types": "./src/env-schema.ts",
      "default": "./src/env-schema.ts"
    },
    "./managed-files": {
      "types": "./src/managed-files/index.ts",
      "default": "./src/managed-files/index.ts"
    },
    "./setup-test-stack-from-features": {
      "types": "./src/setup-test-stack-from-features.ts",
      "default": "./src/setup-test-stack-from-features.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./schema-apply": {
      "types": "./src/schema-apply.ts",
      "default": "./src/schema-apply.ts"
    },
    "./schema-tables-auth-mode": {
      "types": "./src/schema-tables-auth-mode.ts",
      "default": "./src/schema-tables-auth-mode.ts"
    },
    "./schema-tables-minimal": {
      "types": "./src/schema-tables-minimal.ts",
      "default": "./src/schema-tables-minimal.ts"
    },
    "./cli": {
      "types": "./src/cli.ts",
      "default": "./src/cli.ts"
    }
  },
  "bin": {
    "kumiko-build": "./bin/kumiko-build.ts",
    "kumiko-dev": "./bin/kumiko-dev.ts",
    "kumiko-init-deploy": "./bin/kumiko-init-deploy.ts",
    "kumiko-schema": "./bin/kumiko-schema.ts",
    "kumiko-upgrade": "./bin/kumiko-upgrade.ts"
  },
  "dependencies": {
    "@cosmicdrift/kumiko-bundled-features": "workspace:*",
    "@cosmicdrift/kumiko-feature-ast": "workspace:*",
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-renderer": "workspace:*",
    "@cosmicdrift/kumiko-renderer-mail-html": "workspace:*",
    "@cosmicdrift/kumiko-guards": "workspace:*",
    "@cosmicdrift/kumiko-server-runtime": "workspace:*",
    "@cosmicdrift/kumiko-testing": "workspace:*",
    "@cosmicdrift/kumiko-types": "workspace:*",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "bun-types": "^1.4.4"
  },
  "devDependencies": {
    "bun-types": "^1.4.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./build": {
        "types": "./dist/build.d.ts",
        "default": "./dist/build.js"
      },
      "./compose-stacks": {
        "types": "./dist/compose-stacks.d.ts",
        "default": "./dist/compose-stacks.js"
      },
      "./env-schema": {
        "types": "./dist/env-schema.d.ts",
        "default": "./dist/env-schema.js"
      },
      "./managed-files": {
        "types": "./dist/managed-files/index.d.ts",
        "default": "./dist/managed-files/index.js"
      },
      "./setup-test-stack-from-features": {
        "types": "./dist/setup-test-stack-from-features.d.ts",
        "default": "./dist/setup-test-stack-from-features.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./schema-apply": {
        "types": "./dist/schema-apply.d.ts",
        "default": "./dist/schema-apply.js"
      },
      "./schema-tables-auth-mode": {
        "types": "./dist/schema-tables-auth-mode.d.ts",
        "default": "./dist/schema-tables-auth-mode.js"
      },
      "./schema-tables-minimal": {
        "types": "./dist/schema-tables-minimal.d.ts",
        "default": "./dist/schema-tables-minimal.js"
      },
      "./cli": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "src/changes.json",
    "README.md",
    "LICENSE"
  ]
}
