{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rewriteRelativeImportExtensions": false,
    "outDir": "./dist/core",
    "rootDir": ".",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "./src/stack",
    "./src/helpers",
    "./src/preload",
    "./src/bunfig.ts",
    "./src/e2e-timeouts.ts",
    "./src/integration-runner.ts",
    "./src/provider-env-keys.ts",
    "./bin"
  ],
  "exclude": ["./src/**/__tests__/**", "./bin/__tests__/**"],
  "references": [{ "path": "../framework" }, { "path": "../types" }]
}
