{
  "name": "@cosmicdrift/kumiko-testing",
  "version": "0.404.0",
  "description": "Test template for Kumiko apps: per-flow seedTenant, app test stack, canonical test preloads, bunfig generator and integration runner.",
  "license": "MIT",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "type": "module",
  "kumiko": {
    "runtime": "test"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./stack": {
      "types": "./src/stack/index.ts",
      "default": "./src/stack/index.ts"
    },
    "./provider-env-keys": {
      "types": "./src/provider-env-keys.ts",
      "default": "./src/provider-env-keys.ts"
    },
    "./helpers": {
      "types": "./src/helpers/index.ts",
      "default": "./src/helpers/index.ts"
    },
    "./helpers/mock-module": {
      "types": "./src/helpers/mock-module.ts",
      "default": "./src/helpers/mock-module.ts"
    },
    "./helpers/real-providers": {
      "types": "./src/helpers/real-providers.ts",
      "default": "./src/helpers/real-providers.ts"
    },
    "./helpers/e2e-generator": {
      "types": "./src/helpers/e2e-generator.ts",
      "default": "./src/helpers/e2e-generator.ts"
    },
    "./bunfig": {
      "types": "./src/bunfig.ts",
      "default": "./src/bunfig.ts"
    },
    "./integration-runner": {
      "types": "./src/integration-runner.ts",
      "default": "./src/integration-runner.ts"
    },
    "./preload/temporal": {
      "types": "./src/preload/temporal.ts",
      "default": "./src/preload/temporal.ts"
    },
    "./preload/ci-log": {
      "types": "./src/preload/ci-log.ts",
      "default": "./src/preload/ci-log.ts"
    },
    "./preload/scrub-env": {
      "types": "./src/preload/scrub-env.ts",
      "default": "./src/preload/scrub-env.ts"
    },
    "./preload/schema-env-defaults": {
      "types": "./src/preload/schema-env-defaults.ts",
      "default": "./src/preload/schema-env-defaults.ts"
    },
    "./preload/env": {
      "types": "./src/preload/env.ts",
      "default": "./src/preload/env.ts"
    },
    "./preload/real": {
      "types": "./src/preload/real.ts",
      "default": "./src/preload/real.ts"
    },
    "./preload/dom": {
      "types": "./src/preload/dom.ts",
      "default": "./src/preload/dom.ts"
    },
    "./scaffold": {
      "types": "./src/scaffold.ts",
      "default": "./src/scaffold.ts"
    },
    "./e2e": {
      "types": "./src/e2e/index.ts",
      "default": "./src/e2e/index.ts"
    },
    "./e2e/constants": {
      "types": "./src/e2e/constants.ts",
      "default": "./src/e2e/constants.ts"
    },
    "./e2e/seed-route": {
      "types": "./src/e2e/seed-route.ts",
      "default": "./src/e2e/seed-route.ts"
    }
  },
  "bin": {
    "kumiko-testing": "./bin/kumiko-testing.ts"
  },
  "dependencies": {
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-guards": "workspace:*",
    "@cosmicdrift/kumiko-types": "workspace:*",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3"
  },
  "peerDependenciesMeta": {
    "@happy-dom/global-registrator": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cosmicdrift/kumiko-bundled-features": "workspace:*",
    "@cosmicdrift/kumiko-dev-server": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "ts-morph": "^28.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "src",
    "bin",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE",
    "!bin/__tests__/**"
  ]
}
