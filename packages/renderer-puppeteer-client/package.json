{
  "name": "@cosmicdrift/kumiko-renderer-puppeteer-client",
  "version": "0.362.0",
  "description": "Renderer-Foundation plugin: HTTP client for puppeteer-service (PDF + image snapshot via remote browser).",
  "license": "BUSL-1.1",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "type": "module",
  "kumiko": {
    "runtime": "runtime"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-bundled-features": "workspace:*",
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-renderer-mail-html": "workspace:*",
    "@cosmicdrift/kumiko-types": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/renderer-puppeteer-client"
  },
  "homepage": "https://kumiko.rocks",
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src/changes.json",
    "README.md",
    "LICENSE"
  ]
}
