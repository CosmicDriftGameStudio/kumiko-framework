{
  "name": "@cosmicdrift/kumiko-renderer-web",
  "version": "0.378.0",
  "description": "Deprecated shim: re-exports @cosmicdrift/kumiko-renderer/web. Removed after wave 4.",
  "license": "BUSL-1.1",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/renderer-web"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "type": "module",
  "kumiko": {
    "runtime": "client"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./theme-plugin": {
      "types": "./src/theme-plugin.ts",
      "default": "./src/theme-plugin.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-renderer": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./src/styles.css",
      "./theme-plugin": {
        "types": "./dist/theme-plugin.d.ts",
        "default": "./dist/theme-plugin.js"
      }
    }
  },
  "files": [
    "dist",
    "src/changes.json",
    "src/styles.css",
    "README.md",
    "LICENSE"
  ]
}
