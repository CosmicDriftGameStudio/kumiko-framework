{
  "name": "@cosmicdrift/kumiko-repo-manifest",
  "version": "0.377.0",
  "description": "Deprecated shim: re-exports @cosmicdrift/kumiko-guards/repo-manifest. Removed after wave 4.",
  "license": "BUSL-1.1",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/repo-manifest"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "type": "module",
  "kumiko": {
    "runtime": "dev"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app-ports": {
      "types": "./src/app-ports/index.ts",
      "default": "./src/app-ports/index.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-guards": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE"
  ]
}
