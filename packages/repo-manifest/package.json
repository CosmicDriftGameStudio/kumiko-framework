{
  "name": "@cosmicdrift/kumiko-repo-manifest",
  "version": "0.375.0",
  "description": "kumiko.json repo manifest schema and loader.",
  "license": "BUSL-1.1",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/repo-manifest"
  },
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "homepage": "https://kumiko.rocks",
  "type": "module",
  "kumiko": {
    "runtime": "dev"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app-ports": {
      "types": "./src/app-ports/index.ts",
      "default": "./src/app-ports/index.ts"
    }
  },
  "dependencies": {
    "ts-morph": "^28.0.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@cosmicdrift/kumiko-framework": ">=0.366.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "@cosmicdrift/kumiko-framework": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cosmicdrift/kumiko-framework": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "src",
    "!src/**/__tests__/**",
    "README.md",
    "LICENSE"
  ]
}
