{
  "name": "@cosmicdrift/kumiko-document-designer",
  "version": "0.376.0",
  "description": "Document designer for Kumiko: template overview, layout editor (mail layout, PDF letterhead) and the PDF template editor.",
  "license": "BUSL-1.1",
  "author": "Marc Frost <marc@cosmicdriftgamestudio.com>",
  "type": "module",
  "kumiko": {
    "runtime": "runtime"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./web": {
      "types": "./src/web/index.ts",
      "default": "./src/web/index.ts"
    }
  },
  "dependencies": {
    "@cosmicdrift/kumiko-bundled-features": "workspace:*",
    "@cosmicdrift/kumiko-framework": "workspace:*",
    "@cosmicdrift/kumiko-renderer": "workspace:*",
    "@cosmicdrift/kumiko-renderer-puppeteer-client": "workspace:*",
    "@cosmicdrift/kumiko-types": "workspace:*",
    "pdfjs-dist": "6.3.289",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicDriftGameStudio/kumiko-framework.git",
    "directory": "packages/document-designer"
  },
  "homepage": "https://kumiko.rocks",
  "bugs": {
    "url": "https://github.com/CosmicDriftGameStudio/kumiko-framework/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./web": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src/changes.json",
    "README.md",
    "LICENSE"
  ]
}
