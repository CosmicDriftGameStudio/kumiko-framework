{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "packages/**",
      "samples/**",
      "app/**",
      "scripts/**",
      "bin/**",
      "apps/**",
      "!**/drizzle/migrations",
      "!**/dist",
      "!**/dist-server",
      "!**/.kumiko",
      "!**/feature-manifest.json",
      "!**/sample-index.json",
      "!samples/recipes/api-docs/api-docs",
      "!**/CHANGELOG.md",
      "!packages/framework/agents",
      "!**/renderer/src/web/ui"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "lineWidth": 80
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["app/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error",
            "useHookAtTopLevel": "error"
          },
          "a11y": {
            "preset": "recommended",
            "useAltText": "error",
            "useKeyWithClickEvents": "error"
          }
        }
      }
    },
    {
      "includes": [
        "packages/feature-ast/src/codemod/pipeline-codemod.ts",
        "packages/framework/src/logging/utils.ts",
        "packages/create-kumiko-app/**",
        "packages/guards/**",
        "packages/dev-server/src/schema-apply.ts",
        "**/scripts/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/*.integration.ts",
        "**/*.e2e.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/*/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "zod": {
                    "importNames": ["z"],
                    "message": "import * as z from \"zod\" instead — { z } pulls the whole namespace (all locales, json-schema) into client bundles."
                  },
                  "zod/v4": {
                    "importNames": ["z"],
                    "message": "import * as z from \"zod/v4\" instead — { z } pulls the whole namespace (all locales, json-schema) into client bundles."
                  },
                  "zod/v3": {
                    "importNames": ["z"],
                    "message": "import * as z from \"zod/v3\" instead — { z } pulls the whole namespace (all locales, json-schema) into client bundles."
                  },
                  "temporal-polyfill": {
                    "message": "import { Temporal } from \"@cosmicdrift/kumiko-types/temporal\" instead — it prefers the native global, so framework and consumer share one set of Temporal classes."
                  }
                },
                "patterns": [
                  {
                    "group": ["temporal-polyfill/*"],
                    "message": "import { Temporal } from \"@cosmicdrift/kumiko-types/temporal\" instead — it prefers the native global, so framework and consumer share one set of Temporal classes."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "bin/**", "apps/**"],
      "formatter": { "enabled": false },
      "linter": { "rules": { "recommended": false } },
      "assist": { "enabled": false }
    },
    {
      "includes": ["packages/types/src/temporal.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "samples/**/__tests__/**",
        "!samples/recipes/api-worker-split/**",
        "!samples/recipes/inbound-mail-triage/**",
        "!samples/recipes/lane-routing/**",
        "!samples/recipes/user-data-rights/src/__tests__/feature.integration.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@cosmicdrift/kumiko-testing/stack": {
                    "importNames": ["unsafeCreateEntityTable"],
                    "message": "setupTestStack already creates the r.entity tables of the features it gets; drop the call."
                  },
                  "@cosmicdrift/kumiko-framework/event-store": {
                    "importNames": ["createEventsTable"],
                    "message": "setupTestStack already creates the events table; drop the call."
                  },
                  "temporal-polyfill": {
                    "message": "import { Temporal } from \"@cosmicdrift/kumiko-types/temporal\" instead — it prefers the native global, so framework and consumer share one set of Temporal classes."
                  }
                },
                "patterns": [
                  {
                    "group": ["temporal-polyfill/*"],
                    "message": "import { Temporal } from \"@cosmicdrift/kumiko-types/temporal\" instead — it prefers the native global, so framework and consumer share one set of Temporal classes."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "extends": ["./packages/framework/presets/biome-rules.json"]
}
