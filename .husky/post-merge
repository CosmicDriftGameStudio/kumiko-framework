#!/bin/sh
# ponytail: refreshes this repo's own lean-ctx graph after merge/checkout so it
# never goes stale silently; no-op if lean-ctx isn't installed, never blocks git.
# Cross-repo imports (@cosmicdrift/kumiko-*) aren't resolved as graph edges
# anyway, so a per-repo graph loses nothing vs. one shared parent-level graph
# and stays smaller/faster to rebuild.
root=$(git rev-parse --show-toplevel 2>/dev/null)
[ -n "$root" ] && command -v lean-ctx >/dev/null 2>&1 && lean-ctx graph build "$root" >/dev/null 2>&1 &
exit 0
