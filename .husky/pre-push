#!/usr/bin/env sh
# kumiko-managed
# kumiko-managed: local prefers the checked-out packages/guards/src/pre-push.sh so a worktree push runs the branch's hook

REPO_ROOT="$(git rev-parse --show-toplevel)"
if [ -z "$REPO_ROOT" ]; then
  echo "[pre-push] FATAL: git rev-parse --show-toplevel failed — refusing push" >&2
  exit 1
fi

# This repo ships the hook itself: prefer the checked-out copy so a push from a
# `.wt/<name>` worktree runs the branch's hook, not the parent install's
# (main's) version behind node_modules/.bin.
BIN=""
IN_REPO_HOOK="$REPO_ROOT/packages/guards/src/pre-push.sh"
if [ -x "$IN_REPO_HOOK" ]; then
  BIN="$IN_REPO_HOOK"
fi

# Otherwise walk up to the parent-workspace root so a worktree without its own
# node_modules resolves via the parent install. Without such a root only the
# repo's own node_modules is trusted: a bin planted in a shared ancestor
# (/tmp, /Users/Shared) must never be exec'd; `[ -x ]` also skips a broken
# (uninstalled) symlink.
STOP_DIR="$REPO_ROOT"
ANCESTOR="$REPO_ROOT"
while [ "$ANCESTOR" != "/" ]; do
  ANCESTOR="$(dirname "$ANCESTOR")"
  if [ -f "$ANCESTOR/package.json" ] && grep -q '"name": "cosmicdriftgamestudio"' "$ANCESTOR/package.json"; then
    STOP_DIR="$ANCESTOR"
    break
  fi
done

DIR="$REPO_ROOT"
while [ -z "$BIN" ]; do
  CANDIDATE="$DIR/node_modules/.bin/kumiko-pre-push"
  if [ -x "$CANDIDATE" ]; then
    BIN="$CANDIDATE"
    break
  fi
  if [ "$DIR" = "$STOP_DIR" ] || [ "$DIR" = "/" ]; then
    break
  fi
  DIR="$(dirname "$DIR")"
done

if [ -z "$BIN" ]; then
  echo "[pre-push] kumiko-pre-push not found in any node_modules/.bin above $REPO_ROOT." >&2
  echo "Run \`bun install\`." >&2
  exit 1
fi

cd "$REPO_ROOT" && exec "$BIN" "$@"
