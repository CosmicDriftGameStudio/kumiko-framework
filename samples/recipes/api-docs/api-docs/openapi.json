{
  "openapi": "3.1.0",
  "info": {
    "title": "Helpdesk API",
    "version": "0.0.0"
  },
  "servers": [
    {
      "url": "https://ticketing.example.com"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/query": {
      "post": {
        "summary": "Query",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ticketing.query.ticket.detail.request"
                  },
                  {
                    "$ref": "#/components/schemas/ticketing.query.ticket.list.request"
                  }
                ],
                "discriminator": {
                  "propertyName": "type",
                  "mapping": {
                    "ticketing:query:ticket:detail": "#/components/schemas/ticketing.query.ticket.detail.request",
                    "ticketing:query:ticket:list": "#/components/schemas/ticketing.query.ticket.list.request"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean"
                    },
                    "data": {}
                  }
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
