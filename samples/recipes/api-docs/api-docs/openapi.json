  },
  "webhooks": {
    "ticket.created": {
      "post": {
        "summary": "ticket.created",
        "x-kumiko-qn": "ticket.created",
        "description": "A record of type ticket was created.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ticket.created.entity-event"
              }
            }
          }
        },
        "x-kumiko-version": 1,
        "x-kumiko-scope": [
          "tickets:read"
        ]
      }
    },
    "ticket.closed": {
      "post": {
        "summary": "ticket.closed",
        "x-kumiko-qn": "ticketing:ticket-closed",
        "description": "A ticket was closed and its resolution recorded.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ticketing.ticket-closed.event"
              }
            }
          }
        },
        "x-kumiko-version": 1,
        "x-kumiko-scope": [
          "tickets:read"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ticketing.query.ticket.detail.request": {
        "type": "object",
        "description": "Returns one ticket.",
        "required": [
          "type",
          "payload"
        ],
        "properties": {
          "type": {
            "const": "ticketing:query:ticket:detail"
          },
          "payload": {
            "$ref": "#/components/schemas/ticketing.query.ticket.detail.payload"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ticketing.query.ticket.detail.payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "id"
        ]
      },
      "ticketing.query.ticket.list.request": {
        "type": "object",
        "description": "Lists tickets, newest first.",
        "required": [
          "type",
          "payload"
        ],
        "properties": {
          "type": {
            "const": "ticketing:query:ticket:list"
          },
          "payload": {
            "$ref": "#/components/schemas/ticketing.query.ticket.list.payload"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ticketing.query.ticket.list.payload": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "search": {
            "type": "string"
          },
          "sort": {
            "type": "string"
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalCount": {
            "type": "boolean"
          },
          "includeDeleted": {
            "type": "boolean"
          },
          "onlyDeleted": {
            "type": "boolean"
          },
          "filter": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "lt",
                  "gt",
                  "lte",
                  "gte",
                  "in"
                ]
              },
              "value": {}
            },
            "required": [
              "field",
              "op",
              "value"
            ]
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "eq",
                    "ne",
                    "lt",
                    "gt",
                    "lte",
                    "gte",
                    "in"
                  ]
                },
                "value": {}
              },
              "required": [
                "field",
                "op",
                "value"
              ]
            }
          },
          "namedFilter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "aggregate": {
            "type": "object",
            "properties": {
              "groupBy": {
                "type": "string"
              },
              "measures": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "sum",
                        "avg",
                        "count",
                        "min",
                        "max"
                      ]
                    }
                  },
                  "required": [
                    "field",
                    "kind"
                  ]
                }
              }
            }
          }
        }
      },
      "ticketing.write.ticket.close.request": {
        "type": "object",
        "description": "Closes a ticket and records how it was resolved.",
        "required": [
          "type",
          "payload"
        ],
        "properties": {
          "type": {
            "const": "ticketing:write:ticket:close"
          },
          "payload": {
            "$ref": "#/components/schemas/ticketing.write.ticket.close.payload"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ticketing.write.ticket.close.payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "resolution"
        ]
      },
      "ticketing.write.ticket.create.request": {
        "type": "object",
        "description": "Opens a new ticket.",
        "required": [
          "type",
          "payload"
        ],
        "properties": {
          "type": {
            "const": "ticketing:write:ticket:create"
          },
          "payload": {
            "$ref": "#/components/schemas/ticketing.write.ticket.create.payload"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ticketing.write.ticket.create.payload": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ]
          }
        },
        "required": [
          "title"
        ]
      },
      "ticketing.write.ticket.update.request": {
        "type": "object",
        "description": "Changes the title or the priority of a ticket.",
        "required": [
          "type",
          "payload"
        ],
        "properties": {
          "type": {
            "const": "ticketing:write:ticket:update"
          },
          "payload": {
            "$ref": "#/components/schemas/ticketing.write.ticket.update.payload"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "ticketing.write.ticket.update.payload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "version": {
            "type": "number"
          },
          "changes": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "closed"
                ]
              },
              "priority": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high"
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "version",
          "changes"
        ]
      },
      "ticket.created.entity-event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "closed"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "priority"
        ],
        "additionalProperties": false
      },
      "ticketing.ticket-closed.event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "ID of the closed ticket"
          },
          "resolution": {
            "type": "string",
            "description": "How the ticket was resolved"
          }
        },
        "required": [
          "id",
          "resolution"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "access_denied",
                  "ambiguous_auth",
                  "conflict",
                  "feature_disabled",
                  "idempotent_replay",
                  "internal_error",
                  "invalid_token",
                  "member_read_timeout",
                  "missing_token",
                  "not_found",
                  "pat_rate_limited",
                  "precondition_failed",
                  "rate_limit_unavailable",
                  "rate_limited",
                  "record_locked",
                  "unauthenticated",
                  "unconfigured",
                  "unique_violation",
                  "unprocessable",
                  "validation_error",
                  "version_conflict"
                ]
              },
              "httpStatus": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
